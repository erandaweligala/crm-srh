<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS}|%p|%c|%M|%X{API-Name}|%X{Request-Id}|%X{Source-Id}|%m%n
            </pattern>
        </encoder>
    </appender>

    <logger name="com.adl.et.telco.comet.securerequesthandler" level="debug" />
    <root level="debug">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>